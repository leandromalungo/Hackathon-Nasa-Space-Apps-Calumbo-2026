# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MBONGO External Agroclimatic & Satellite Providers (optional — Demo Mode active if unset)
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/daily/point"
METEOMATICS_USERNAME=""
METEOMATICS_PASSWORD=""
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""
CHIRPS_API_URL=""

# MBONGO USSD & SMS Gateway Configuration (optional — Simulator Mode active if unset)
USSD_PROVIDER_NAME=""
USSD_WEBHOOK_SECRET=""
USSD_GATEWAY_URL=""
SMS_PROVIDER_URL=""
SMS_API_KEY=""

# Platform Mode
DEMO_MODE="true"
